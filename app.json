{
  "expo": {
    "name": "Toss the Turkeys",
    "slug": "toss-the-turkeys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "tossturkeys",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-farm.png",
          "resizeMode": "cover",
          "backgroundColor": "#F7E8C8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon.png",
        "backgroundColor": "#5B2D1D"
      }
    },
    "ios": {
      "supportsTablet": true
    }
  }
}
